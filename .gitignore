# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# OS
.DS_Store
Thumbs.db

# Translations
# Compiled .qm files ARE shipped: the application loads them at runtime, so the
# ones under translations/ must be committed together with their .ts source.
*.qm
!translations/*.qm
translations/*.ts.bak

# Test files created during benchmarks
.usb_test_tmp
.fio_test_tmp

# Logs
*.log

# Environment
.env
.env.local

# PyQt6
*.pyc

# Local packaging sandbox used to build the .deb without polluting the parent
# directory (see the "Debian packaging" section of the README)
/.build/

# Personal
8vo/
